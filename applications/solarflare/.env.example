# Every key is optional: `solarflare sample` runs with none.

# To read your Cloudflare account. A custom, read-only token:
# Cloudflare dashboard > My Profile > API Tokens > Create Token > Create Custom Token.
# Permissions, all Read:
#   Account: Account Analytics, Workers Scripts, Cloudflare Pages
#   Zone:    Zone, Analytics, Workers Routes
CLOUDFLARE_API_TOKEN=

# For AI investigations (`investigate`, `summary --investigate N`).
# Solari runs the agent's queries in a hardened sandbox: https://console.getsolari.com (free plan is enough).
SOLARI_API_KEY=
# A restricted OpenAI key: Models read, Responses write.
OPENAI_API_KEY=

# Optional: your Workers plan (free or paid), so `usage` shows headroom without --plan.
CLOUDFLARE_WORKERS_PLAN=
